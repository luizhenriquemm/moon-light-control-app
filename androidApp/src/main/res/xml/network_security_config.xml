<?xml version="1.0" encoding="utf-8"?>
<!-- Servers are user-typed LAN addresses served over plain HTTP by default, so cleartext must be
     allowed everywhere (there is no fixed domain list). Self-signed HTTPS is handled per host by
     certificate pinning in the app, not here. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
